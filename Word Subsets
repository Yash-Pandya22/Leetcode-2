class Solution {
public:
    vector<string> wordSubsets(vector<string>& words1, vector<string>& words2) {
        vector<int> required(26, 0);
        for (string word : words2) {
            vector<int> count(26, 0);

            for (char ch : word)
                count[ch - 'a']++;

            for (int i = 0; i < 26; i++)
                required[i] = max(required[i], count[i]);
        }

        vector<string> ans;
        for (string word : words1) {
            vector<int> count(26, 0);

            for (char ch : word)
                count[ch - 'a']++;

            bool universal = true;

            for (int i = 0; i < 26; i++) {
                if (count[i] < required[i]) {
                    universal = false;
                    break;
                }
            }

            if (universal)
                ans.push_back(word);
        }

        return ans;
    }
};
