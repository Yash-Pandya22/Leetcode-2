class Solution {
public:
    string findReplaceString(string s, vector<int>& indices,
                             vector<string>& sources,
                             vector<string>& targets) {
        
        string ans = "";

        for (int i = 0; i < s.length(); ) {
            bool replaced = false;

            for (int j = 0; j < indices.size(); j++) {
                if (indices[j] == i &&
                    s.substr(i, sources[j].length()) == sources[j]) {
                    
                    ans += targets[j];
                    i += sources[j].length();
                    replaced = true;
                    break;
                }
            }

            if (!replaced) {
                ans += s[i];
                i++;
            }
        }

        return ans;
    }
};
