class Solution {
public:
    string countAndSay(int n) {
        string s = "1";

        for (int k = 1; k < n; k++) {
            string ans = "";

            for (int i = 0; i < s.length(); ) {
                int count = 1;

                while (i + count < s.length() && s[i] == s[i + count])
                    count++;

                ans += to_string(count);
                ans += s[i];

                i += count;
            }

            s = ans;
        }

        return s;
    }
};
