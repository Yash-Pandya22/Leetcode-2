class Solution {
public:
    string add(string a, string b) {
        string ans = "";
        int i = a.length() - 1;
        int j = b.length() - 1;
        int carry = 0;

        while (i >= 0 || j >= 0 || carry) {
            int sum = carry;

            if (i >= 0)
                sum += a[i--] - '0';

            if (j >= 0)
                sum += b[j--] - '0';

            ans += char(sum % 10 + '0');
            carry = sum / 10;
        }

        reverse(ans.begin(), ans.end());
        return ans;
    }

    bool check(string& num, int start, string a, string b, int count) {
        if (start == num.length())
            return count >= 3;

        string sum = add(a, b);

        if (num.substr(start, sum.length()) != sum)
            return false;

        return check(num, start + sum.length(), b, sum, count + 1);
    }

    bool isAdditiveNumber(string num) {
        int n = num.length();

        for (int i = 1; i < n; i++) {
            if (i > 1 && num[0] == '0')
                break;

            string a = num.substr(0, i);

            for (int j = i + 1; j < n; j++) {
                if (j - i > 1 && num[i] == '0')
                    break;

                string b = num.substr(i, j - i);

                if (check(num, j, a, b, 2))
                    return true;
            }
        }

        return false;
    }
};
